{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["jest", "node"],
    "noImplicitAny": false,
    "strict": false,
    "strictNullChecks": false,
    "noEmit": true
  },
  "include": ["src"]
}
